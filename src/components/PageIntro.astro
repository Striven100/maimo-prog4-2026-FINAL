---
const { index = '00', title, description, marker = 'estructura' } = Astro.props;
---
<section class="page-intro" aria-labelledby="page-title">
  <div class="page-intro__meta">
    <span>{index}</span>
    <span>{marker}</span>
  </div>
  <h1 id="page-title">{title}</h1>
  <p>{description}</p>
  <slot />
</section>
