---
import Icon from "./Icon.astro";
import ProjectGallery from "./ProjectGallery.astro";

const { project } = Astro.props;
---

<dialog class="project-dialog" id={`project-${project.id}`} data-project-dialog>
  <div class="project-dialog__frame">
    <header class="project-dialog__topbar">
      <div>
        <span>{project.number}</span>
        <strong>{project.projectType}</strong>
      </div>
      <button type="button" class="icon-button" data-dialog-close aria-label={`Cerrar detalle de ${project.title}`}>
        <Icon name="close" size={22} />
      </button>
    </header>

    <div class="project-dialog__scroll">
      <section class="project-dialog__hero">
        <div class="project-dialog__intro">
          <p>{project.category}</p>
          <h2>{project.title}</h2>
          <strong>{project.subtitle}</strong>
          <p>{project.description}</p>
        </div>
        <ProjectGallery project={project} />
      </section>

      <section class="project-dialog__facts" aria-label="Información del proyecto">
        <article>
          <span>01</span>
          <h3>Desafío</h3>
          <p>{project.challenge}</p>
        </article>
        <article>
          <span>02</span>
          <h3>Enfoque</h3>
          <p>{project.process || project.role}</p>
        </article>
        <article>
          <span>03</span>
          <h3>Resultado</h3>
          <p>{project.result}</p>
        </article>
      </section>

      <section class="project-dialog__system">
        <div>
          <p class="section-kicker">Sistema visual</p>
          <h3>Herramientas y enlaces</h3>
        </div>
        <ul class="dialog-tools">
          {project.tools.map((tool: string) => <li>{tool}</li>)}
        </ul>
        <div class="project-dialog__resources">
          {project.links?.live && <a href={project.links.live} target="_blank" rel="noreferrer">Ver proyecto <Icon name="arrow" size={16} /></a>}
          {project.links?.caseStudy && <a href={project.links.caseStudy} target="_blank" rel="noreferrer">Caso completo <Icon name="arrow" size={16} /></a>}
          {project.links?.repository && <a href={project.links.repository} target="_blank" rel="noreferrer">Repositorio <Icon name="arrow" size={16} /></a>}
          {project.pdfs?.map((pdf: any) => <a href={pdf.url} target="_blank" rel="noreferrer">{pdf.title || pdf.name} · PDF <Icon name="file" size={16} /></a>)}
          <a href={`/trabajos/${project.slug}`}>Abrir página del proyecto <Icon name="arrow" size={16} /></a>
        </div>
      </section>
    </div>
  </div>
</dialog>

