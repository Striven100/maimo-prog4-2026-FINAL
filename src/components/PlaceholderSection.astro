---
const {
  number,
  title,
  note = "Sección lista para completar",
  media = false,
  wide = false
} = Astro.props;
---

<section class:list={["placeholder-section", { "placeholder-section--wide": wide }]}> 
  <div class="placeholder-section__heading">
    <span>{number}</span>
    <div>
      <p>{note}</p>
      <h2>{title}</h2>
    </div>
  </div>

  {media && (
    <div class="media-placeholder" aria-label="Espacio reservado para contenido visual">
      <span>Contenido visual</span>
      <small>Agregar imagen, video o prototipo</small>
    </div>
  )}

  <div class="copy-placeholder" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
</section>

