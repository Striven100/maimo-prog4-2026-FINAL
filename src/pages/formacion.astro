---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---

<BaseLayout title="Formación | Portfolio base">
  <PageHeader
    eyebrow="Trayectoria / 04"
    title="Formación"
    description="Estructura lista para incorporar estudios, cursos, certificaciones y aprendizaje continuo."
  />

  <div class="content-grid">
    <PlaceholderSection number="01" title="Estudios principales" />
    <PlaceholderSection number="02" title="Cursos y certificaciones" />
    <PlaceholderSection number="03" title="Talleres y actividades" />
    <PlaceholderSection number="04" title="Aprendizaje continuo" />
  </div>
</BaseLayout>

