---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PlaceholderSection from "../components/PlaceholderSection.astro";
---

<BaseLayout title="Sobre mí | Portfolio base">
  <PageHeader
    eyebrow="Perfil / 01"
    title="Sobre mí"
    description="Página preparada para presentar el perfil, la forma de trabajo y las capacidades principales."
  />

  <div class="profile-placeholder">
    <div class="portrait-placeholder">
      <span>Retrato o recurso visual</span>
      <small>Espacio opcional</small>
    </div>

    <div class="content-grid">
      <PlaceholderSection number="01" title="Presentación" />
      <PlaceholderSection number="02" title="Enfoque de trabajo" />
      <PlaceholderSection number="03" title="Habilidades" />
      <PlaceholderSection number="04" title="Herramientas" />
    </div>
  </div>
</BaseLayout>

