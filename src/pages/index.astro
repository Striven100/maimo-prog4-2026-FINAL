---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mainNavigation, projectCategories } from "../config/navigation.js";
---

<BaseLayout title="Portfolio | Estructura base">
  <section class="home-hero">
    <div class="home-hero__meta">
      <span>Portfolio / Base</span>
      <span>Versión 01</span>
    </div>

    <h1>
      <span>Nombre</span>
      <span>del portfolio</span>
    </h1>

    <div class="home-hero__footer">
      <p>Espacio reservado para una presentación breve y el enfoque profesional.</p>
      <a href="/proyectos">Explorar estructura <span aria-hidden="true">↘</span></a>
    </div>
  </section>

  <section class="site-map" aria-labelledby="mapa-titulo">
    <div class="section-title">
      <p>01 / Mapa del sitio</p>
      <h2 id="mapa-titulo">Páginas principales</h2>
    </div>

    <div class="route-list">
      {mainNavigation.slice(1).map((item, index) => (
        <a href={item.href}>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{item.label}</strong>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="category-preview" aria-labelledby="categorias-titulo">
    <div class="section-title">
      <p>02 / Archivo</p>
      <h2 id="categorias-titulo">Categorías de proyectos</h2>
    </div>

    <div class="category-grid">
      {projectCategories.map((category) => (
        <a class="category-card" href={category.href}>
          <span>{category.number}</span>
          <h3>{category.title}</h3>
          <p>{category.description}</p>
          <b aria-hidden="true">↗</b>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

