---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<BaseLayout title="Contacto | Portfolio base">
  <PageHeader
    eyebrow="Contacto / 05"
    title="Hablemos"
    description="Página preparada para añadir vías de contacto y perfiles profesionales."
  />

  <section class="contact-placeholder">
    <div>
      <p>Correo electrónico</p>
      <span>dirección pendiente</span>
    </div>
    <div>
      <p>LinkedIn</p>
      <span>enlace pendiente</span>
    </div>
    <div>
      <p>Ubicación</p>
      <span>información pendiente</span>
    </div>
    <div>
      <p>Disponibilidad</p>
      <span>estado pendiente</span>
    </div>
  </section>
</BaseLayout>

