---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import ApiStatus from '../components/ApiStatus.astro';
import SiteFooter from '../components/SiteFooter.astro';

const {
  title = 'Portfolio / estructura base',
  description = 'Primera etapa estructural de un portfolio desarrollado con Astro.',
  page = 'home'
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f4f7" />
    <title>{title}</title>
  </head>
  <body data-page={page}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <SiteHeader currentPage={page} />
    <main id="contenido"><slot /></main>
    <ApiStatus />
    <SiteFooter />
    <script src="../scripts/page.js"></script>
  </body>
</html>
