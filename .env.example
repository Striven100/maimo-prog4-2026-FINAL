# Opcional en local. Obligatoria si exponés escrituras en un servidor.
PORTFOLIO_ADMIN_KEY=cambiar-por-una-clave-segura

# Vercel añade automáticamente las credenciales de Blob al conectar el
# almacenamiento al proyecto. No copies tokens reales a este archivo.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

# Ruta alternativa para la base JSON, útil para pruebas.
# PORTFOLIO_DATA_FILE=/ruta/absoluta/portfolio.json
